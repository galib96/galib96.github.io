@article{khan2025smart,
  author = {Khan, Galib and Sanford, C. and Trinh, Cong T.},
  title = {Smart culture medium optimization for recombinant protein production: Experimental, modeling, and AI/ML-driven strategies},
  journal = {Biotechnology Advances},
  year = {2025},
  pages = {108738},
  doi = {10.1016/j.biotechadv.2024.108738},
  url = {https://doi.org/10.1016/j.biotechadv.2024.108738},
  abstract = {This comprehensive review explores the integration of experimental approaches, mathematical modeling, and artificial intelligence/machine learning strategies for optimizing culture medium in recombinant protein production. The paper presents state-of-the-art methodologies that combine traditional bioprocess engineering with modern computational techniques to enhance protein yield and quality in biomanufacturing systems.},
  keywords = {Culture Medium Optimization, Recombinant Protein Production, Machine Learning, Bioprocess Engineering, AI-driven Optimization, Biomanufacturing},
  selected = {true},
  preview = {culture-medium.png}
}

@inproceedings{khan2025multiobj,
  author = {Khan, Galib Hassan and Trinh, Cong T.},
  title = {A Multi-Objective Optimization Framework for Scalable Biomanufacturing through Modular Cell Design and Resource Allocation},
  booktitle = {2025 AIChE Annual Meeting},
  publisher = {AIChE},
  year = {2025},
  abstract = {This work presents a novel multi-objective optimization framework for scalable biomanufacturing that leverages modular cell design principles and optimal resource allocation strategies. The framework addresses the challenge of designing efficient microbial cell factories by balancing multiple competing objectives including productivity, yield, and robustness. The approach enables systematic optimization of metabolic pathways and cellular resources for industrial-scale bioprocessing applications.},
  keywords = {Multi-Objective Optimization, Biomanufacturing, Modular Cell Design, Resource Allocation, Metabolic Engineering, Synthetic Biology},
  selected = {true},
  preview = {modular-design.png}
}

